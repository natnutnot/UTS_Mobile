<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Two">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_marginTop="36dp"
            android:contentDescription="Foto Tralalero"
            android:scaleType="centerCrop"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.497"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/nameText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tralalero Tralala"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toBottomOf="@id/profileImage"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/desc1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mahasiswa S-1 Teknologi Informasi\nUniversitas Lambung Mangkurat"
            android:textSize="14sp"
            android:textColor="#000000"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/nameText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/contactText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+6287-7777-7772\n2310817120002@mhs.ulm.ac.id\n\nSaya adalah  meme absurd dari TikTok tahun 2025 yang menjadi bagian dari tren Italian Brainrot. Meme ini menampilkan suara AI berbahasa Italia dengan frasa seperti Tralalero Tralala, porco dio e porco Allah diiringi gambar aneh seperti hiu pakai sepatu Nike. Pertama kali viral oleh pengguna @eZburger401 dan @andy.promaxo, tren ini kemudian meledak lewat remix phonk yang digunakan di video anime dan bola. Tralalero adalah contoh fenomena Italian Brainrot—konten absurd berbahasa Italia dengan hewan hasil AI. ."
            android:textSize="12sp"
            android:textColor="#555555"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/desc1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="12dp" />

        <TextView
            android:id="@+id/titleAchievements"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Daftar Prestasi dan Partisipasi"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#000000"
            app:layout_constraintTop_toBottomOf="@id/contactText"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/achievements"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="7dp"
            android:text="Viral di TikTok awal 2025, dipopulerkan oleh akun seperti @eZburger401 dan @andy.promaxo.

Mendominasi konten remix phonk, sering digunakan dalam edit-an anime, bola, dan meme absurd.

Bagian dari fenomena Italian Brainrot, bergabung dengan tren seperti Bombardiro Crocodilo, Patapim, dll.

Mendorong tren AI-generated absurdist content, menggunakan suara AI dan gambar hewan aneh buatan AI.

Diliput di KnowYourMeme, menandakan sudah jadi bagian dari katalog budaya internet internasional."
            android:textColor="#555555"
            app:layout_constraintTop_toBottomOf="@id/titleAchievements"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
